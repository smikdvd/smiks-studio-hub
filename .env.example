# ─────────────────────────────────────────────
#  Smiks' Studio Hub — Environment Variables
# ─────────────────────────────────────────────
#
# Copy this file to .env.local for local development,
# or set these variables in your hosting platform's dashboard.
#
# Recommended free PostgreSQL providers:
#   • Neon      → https://neon.tech         (serverless, Vercel-native)
#   • Supabase  → https://supabase.com      (full-featured)
#   • Railway   → https://railway.app       (simple, includes hosting)
#   • Aiven     → https://aiven.io          (managed)
# ─────────────────────────────────────────────

# Primary database connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://user:password@host:5432/smiks_hub?schema=public"

# Direct (non-pooled) connection — required by Prisma Migrate.
# On Neon/Supabase use the "direct" / "session-mode" connection string here.
# If your provider doesn't use connection pooling, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/smiks_hub?schema=public"
