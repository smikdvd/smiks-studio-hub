# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build output
/.next/
/out/
/build

# production
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files — NEVER commit these
# Broad pattern so new variants (.env.migration, .env.staging, …) are covered by default
.env
.env.*
# .env.example is safe to commit (it has no real secrets)
!.env.example

# database files
*.db
*.db-journal
*.db-shm
*.db-wal
dev.db

# vercel
.vercel

# OS
.DS_Store
Thumbs.db

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/prisma

.vercel
